// Google Maps SDK key (client rendering key). Copy to Secrets.xcconfig
// (same directory, git-ignored) and fill in your key. Never commit the key.
//
// Create the key in a billing-enabled Google Cloud project, and restrict it:
//   - Android: package com.guide.guide + your signing key's SHA-1
//   - iOS: bundle id com.guide.app (CFBundleIdentifier)
GMSS_MAPS_KEY=YOUR_KEY_HERE
